[Unit]
Description=AstrBot (QQ + room_link)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/astrbot/venv/bin/astrbot run
Restart=always
RestartSec=8
LimitNOFILE=65535
StandardOutput=append:/root/data/logs/astrbot-stdout.log
StandardError=append:/root/data/logs/astrbot-stderr.log

[Install]
WantedBy=multi-user.target
