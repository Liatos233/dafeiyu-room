{
  "provider": {
    "description": "生图后端：zhipu=智谱 CogView，qwen=阿里 Qwen-Image",
    "type": "string",
    "default": "qwen",
    "options": ["qwen", "zhipu"]
  },
  "api_key": {
    "description": "智谱 BigModel API Key（provider=zhipu 时用）",
    "type": "string",
    "default": ""
  },
  "qwen_api_key": {
    "description": "阿里云 DashScope API Key（provider=qwen 时用）",
    "type": "string",
    "default": ""
  },
  "qwen_model": {
    "description": "Qwen 图像模型名",
    "type": "string",
    "default": "qwen-image-3.0"
  },
  "qwen_endpoint": {
    "description": "Qwen 生图端点（一般不用改）",
    "type": "string",
    "default": "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
  },
  "model": {
    "description": "智谱生图模型",
    "type": "string",
    "default": "cogview-4-250304"
  },
  "size": {
    "description": "默认尺寸（智谱用 1024x1024；Qwen 会自动转成 1024*1024）",
    "type": "string",
    "default": "1024x1024",
    "options": ["1024x1024", "768x1344", "864x1152", "1344x768", "1152x864", "1440x720", "720x1440"]
  },
  "owner_qq": {
    "description": "允许触发的 QQ 号",
    "type": "string",
    "default": "<owner-qq>"
  },
  "daily_limit": {
    "description": "每人每天最多画几张（0=不限）",
    "type": "int",
    "default": 20
  }
}
