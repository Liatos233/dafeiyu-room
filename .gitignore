# 依赖
node_modules/
.npm-cache/

# 本地配置和运行时状态 —— 绝对不要提交
config.json
state/
audio/
backups/
*.log
*.bak
*.bak-*
.env
.env.*

# 个人素材：保留说明文件，其余全部忽略
assets/*
!assets/README.md
public/room/assets/models/*
!public/room/assets/models/README.md
!public/room/assets/models/da-feiyu.opt.glb
!public/room/assets/models/da-feiyu.glb

# 个人角色卡：只保留示例和说明
roles/*.md
!roles/README.md
!roles/example.md

# 本地系统文件
.DS_Store
Thumbs.db
*.swp

# 根目录原始 3D 源文件（与 public/room/assets/models 重复，体积大）
/anime maid 3d model.glb

# 截图/调试产物
shots/

# 本地缓存/截图
.preview/
screenshots/

# 迁移/同步产物（体积大，不入库）
_migrate/
backups/
*.tar.gz

# 部署时在服务器生成的资产清单（运行时产物）
assets-manifest.json

# 前端构建产物（本地 npm run build 生成，不入库）
dist/

# 无头渲染验证截图（调试产物）
.shots/

# 临时调试/部署脚本（本地草稿，不入库）
.tmp-state/

# Python 字节码（每次运行插件都会变，且会把字符串常量带进仓库）
__pycache__/
*.pyc
*.pyo
